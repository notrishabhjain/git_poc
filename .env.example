# Database
DATABASE_URL=postgresql+asyncpg://assistant:changeme@postgres:5432/assistant

# Redis
REDIS_URL=redis://redis:6379/0

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_SECRET=changeme-generate-a-real-key

# AI Providers (all free tiers)
GROQ_API_KEY=gsk_changeme
NVIDIA_API_KEY=nvapi-changeme
CEREBRAS_API_KEY=changeme

# Google Calendar OAuth
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ntfy.sh push notifications
NTFY_TOPIC=your-private-topic-changeme
NTFY_TOKEN=

# Auth
JWT_SECRET=changeme-use-a-long-random-string
DASHBOARD_PASSWORD=changeme

# Bridge shared secret (HMAC auth between bridge and backend)
BRIDGE_SHARED_SECRET=changeme-shared-secret

# Backend URL (used by bridge to forward messages)
BACKEND_WEBHOOK_URL=http://backend:8000/api/v1/webhooks/whatsapp/message
BRIDGE_URL=http://baileys-bridge:3001

# App settings
TIMEZONE=Asia/Kolkata
WORKING_HOURS_START=09:00
WORKING_HOURS_END=19:00

# Postgres (for docker-compose)
DB_PASSWORD=changeme
